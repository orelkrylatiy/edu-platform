# Create a strong owner password locally: python scripts/generate_credentials.py
WORKSPACE_USER=learner
WORKSPACE_PASSWORD=
# New accounts require explicit activation. For a public VPS set invite code too.
WORKSPACE_ALLOW_REGISTRATION=0
WORKSPACE_INVITE_CODE=
# Cookies must be Secure behind HTTPS. Set 0 only for local HTTP development.
WORKSPACE_COOKIE_SECURE=1
# Set to your exact HTTPS origin in production; leave empty for localhost tests.
WORKSPACE_PUBLIC_ORIGIN=
# Each account shares the server's AI credentials. Bound per-account cost.
WORKSPACE_AI_DAILY_LIMIT=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
HUMANIZER_OPENCODE_MODEL=
WORKSPACE_ENABLE_HUMANIZER=0
WORKSPACE_ENABLE_OPENCODE=0
