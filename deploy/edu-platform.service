[Unit]
Description=Learning Workspace
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/projects/edu-platform/current
Environment=CONTENT_REPOSITORY=orelkrylatiy/edu-platform
Environment=CONTENT_BRANCH=content
Environment=CONTENT_SYNC_INTERVAL=3600
EnvironmentFile=/var/www/projects/edu-platform/shared/.env
ExecStart=/var/www/projects/edu-platform/current/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
