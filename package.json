{
  "name": "learning-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint src vite.config.js",
    "format": "prettier --write src vite.config.js index.html playwright.config.js e2e",
    "format:check": "prettier --check src vite.config.js index.html playwright.config.js e2e",
    "test": "node --test src/learning.test.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "vite": "6.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "lucide-react": "0.511.0"
  },
  "devDependencies": {
    "eslint": "9.27.0",
    "@eslint/js": "9.27.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "@playwright/test": "1.52.0"
  }
}
